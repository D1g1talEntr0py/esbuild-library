{
  "name": "esbuild-library",
  "author": "D1g1talEntr0py",
  "version": "1.0.9",
  "license": "ISC",
  "description": "Creates script files for both ES modules and global variables. No CommonJS here!",
  "homepage": "https://github.com/D1g1talEntr0py/esbuild-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1g1talEntr0py/esbuild-library.git"
  },
  "bugs": {
    "url": "https://github.com/D1g1talEntr0py/esbuild-library/issues"
  },
  "maintainers": [
    {
      "name": "D1g1talEntr0py",
      "email": "jason.dimeo@gmail.com"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esbuild-library.d.ts",
      "import": "./dist/esbuild-library.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsbuild",
    "build:watch": "tsbuild --watch",
    "type-check": "tsbuild --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config ./src",
    "prepublishOnly": "pnpm lint && pnpm build"
  },
  "dependencies": {
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "esbuild": "^0.28.2",
    "esbuild-plugin-swc-minify": "^2.2.2"
  },
  "devDependencies": {
    "@d1g1tal/tsbuild": "3.0.3",
    "@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "keywords": [
    "esbuild",
    "library"
  ]
}
